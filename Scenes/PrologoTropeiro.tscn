[node name="Speaker" type="Label" parent="UILayer/Page2Container/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "Mestre Bento (Taverneiro Manco):"

[node name="Text" type="Label" parent="UILayer/Page2Container/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "« — Entrai, tropeiro... tirai a poeira dos pés e cuidai das vossas algibeiras. Há três homens neste salão com prata viva e pressa de mandar carga morro acima antes da chuva.

Mas nesta serra, tropeiro, cada ouro cobra seu preço na balança do Diabo. Uns trazem o ferro da guerra; outros trazem o sal da Câmara... e outros guardam segredos santos. Olhai bem antes de dar vossa palavra! »"
autowrap_mode = 2

