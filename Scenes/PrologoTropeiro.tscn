[node name="Title" type="Label" parent="UILayer/Page1Container/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.88, 0.5, 1)
theme_override_font_sizes/font_size = 14
text = "📜 CAPÍTULO I — O CAIS DE SANTOS (1645)"
horizontal_alignment = 1

[node name="Text" type="Label" parent="UILayer/Page1Container/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 12
text = "O salitre do mar da Capitania de São Vicente mistura-se ao suor dos marinheiros e ao cheiro de peixe seco. Diante de ti, além dos telhados coloniais, ergue-se a colossal muralha verde da Serra de Paranapiacaba.

A mulinha 'Bonita' bufa na calçada de pedra. Para subir o planalto até São Paulo de Piratininga, tu precisas de uma carga paga. E o único lugar para achar serviço é na taverna do cais..."
autowrap_mode = 2

[node name="BtnPage1Next" type="Button" parent="UILayer/Page1Container/Margin/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_gold")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_gold_hover")
text = "ENTRAR NA TAVERNA DO PESCADOR TORTO ▶"

